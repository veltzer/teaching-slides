classDiagram
    class Switchable {
        <<interface>>
        +turnOn()
        +turnOff()
    }
    class Switch {
        -device: Switchable
        +operate()
    }
    class LightBulb {
        +turnOn()
        +turnOff()
    }
    class Fan {
        +turnOn()
        +turnOff()
    }
    
    Switch --> Switchable
    Switchable <|.. LightBulb
    Switchable <|.. Fan