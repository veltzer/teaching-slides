sequenceDiagram
    participant App as Application
    participant Cache
    participant DB as Data Store

    App->>Cache: Check for data
    alt Data in cache
        Cache->>App: Return data
    else Data not in cache
        Cache->>App: Data not found
        App->>DB: Retrieve data
        DB->>App: Return data
        App->>Cache: Store data
        App->>App: Use data
    end