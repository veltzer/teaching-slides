graph TB
    subgraph "Virtual Machines"
        A[App A] --> VA[Guest OS A]
        B[App B] --> VB[Guest OS B]
        VA & VB --> H[Hypervisor]
        H --> OS1[Host OS]
        OS1 --> HW1[Hardware]
    end
    
    subgraph "Containers"
        C[App C] --> D[Container Runtime]
        E[App D] --> D
        D --> OS2[Host OS]
        OS2 --> HW2[Hardware]
    end