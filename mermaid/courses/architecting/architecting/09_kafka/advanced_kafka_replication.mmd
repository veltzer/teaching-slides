graph TB
subgraph "Partition Replication"
L[Leader<br/>Broker 1]
F1[Follower<br/>Broker 2]
F2[Follower<br/>Broker 3]
end

P[Producer] -->|Write| L
L -->|Replicate| F1
L -->|Replicate| F2

C[Consumer] -->|Read| L

L -.->|ISR| ISR[In-Sync<br/>Replicas]
F1 -.->|ISR| ISR
F2 -.->|ISR| ISR

style L fill:#e3f2fd
style F1 fill:#f3e5f5
style ISR fill:#e8f5e9
